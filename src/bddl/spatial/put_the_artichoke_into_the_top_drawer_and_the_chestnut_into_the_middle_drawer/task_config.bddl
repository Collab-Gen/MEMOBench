(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the artichoke into the top drawer and the chestnut into the middle drawer of the cabinet)
    (:regions
      (wooden_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.01 -0.31 0.01 -0.29)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (bottle_of_detergent_init_region
          (:target kitchen_table)
          (:ranges (
              (0.14 -0.01 0.22 0.07)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (artichoke_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.06 0.00 0.02 0.08)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (bag_of_snacks_init_region
          (:target kitchen_table)
          (:ranges (
              (0.14 0.26 0.22 0.34)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (chestnut_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 0.37 0.05 0.45)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_region
          (:target wooden_cabinet_1)
      )
      (middle_region
          (:target wooden_cabinet_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_1 - wooden_cabinet
  )

  (:objects
    bottle_of_detergent__1_1 - bottle_of_detergent__1
    bag_of_snacks_1 - bag_of_snacks
    artichoke_1 - artichoke
    chestnut__2_1 - chestnut__2
  )

  (:obj_of_interest
    wooden_cabinet_1
    bottle_of_detergent__1_1
    bag_of_snacks_1
    artichoke_1
    chestnut__2_1
  )

  (:init
    (On wooden_cabinet_1 kitchen_table_wooden_cabinet_init_region)
    (On bottle_of_detergent__1_1 kitchen_table_bottle_of_detergent_init_region)
    (On bag_of_snacks_1 kitchen_table_bag_of_snacks_init_region)
    (On artichoke_1 kitchen_table_artichoke_init_region)
    (On chestnut__2_1 kitchen_table_chestnut_init_region)
  )

  (:goal
    (And (In artichoke_1 wooden_cabinet_1_top_region) (In chestnut__2_1 wooden_cabinet_1_middle_region) (Close wooden_cabinet_1_top_region) (Close wooden_cabinet_1_middle_region))
  )

)
