(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the charger into the top drawer and the cap into the middle drawer of the cabinet)
    (:regions
      (wooden_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.01 -0.31 0.01 -0.29)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (bottle_of_fabric_softener_init_region
          (:target kitchen_table)
          (:ranges (
              (0.14 -0.01 0.22 0.07)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (charger_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.06 0.00 0.02 0.08)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (carton_of_milk_init_region
          (:target kitchen_table)
          (:ranges (
              (0.14 0.26 0.22 0.34)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cap_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.03 0.37 0.05 0.45)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_region
          (:target wooden_cabinet_1)
      )
      (middle_region
          (:target wooden_cabinet_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_1 - wooden_cabinet
  )

  (:objects
    bottle_of_fabric_softener_1 - bottle_of_fabric_softener
    carton_of_milk__6_1 - carton_of_milk__6
    charger_1 - charger
    cap__2_1 - cap__2
  )

  (:obj_of_interest
    wooden_cabinet_1
    bottle_of_fabric_softener_1
    carton_of_milk__6_1
    charger_1
    cap__2_1
  )

  (:init
    (On wooden_cabinet_1 kitchen_table_wooden_cabinet_init_region)
    (On bottle_of_fabric_softener_1 kitchen_table_bottle_of_fabric_softener_init_region)
    (On carton_of_milk__6_1 kitchen_table_carton_of_milk_init_region)
    (On charger_1 kitchen_table_charger_init_region)
    (On cap__2_1 kitchen_table_cap_init_region)
  )

  (:goal
    (And (In charger_1 wooden_cabinet_1_top_region) (In cap__2_1 wooden_cabinet_1_middle_region) (Close wooden_cabinet_1_top_region) (Close wooden_cabinet_1_middle_region))
  )

)
